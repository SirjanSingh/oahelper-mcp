# Copy this file to .env (same folder) and fill in from a logged-in browser tab.
# .env is gitignored. Never paste these values into chat.
#
# How to get them (Chrome):
#   1. Open https://www.oahelper.in while logged in to your Pro account.
#   2. F12 -> Network tab -> reload -> click any request whose URL has /api/proxy/.
#   3. Under "Request Headers", copy the whole value of `cookie` into OAHELPER_COOKIE.
#   4. If that request also has an `authorization` header, copy it into OAHELPER_BEARER.
#   5. Optional: copy `user-agent` too, so requests look like the same browser session
#      rather than a new device.
# The session expires when you log out on the site. Repeat the steps then.

OAHELPER_COOKIE=
OAHELPER_BEARER=
OAHELPER_USER_AGENT=

# Live requests per day before the server refuses (default 300). Keep it low.
OAHELPER_DAILY_CAP=
